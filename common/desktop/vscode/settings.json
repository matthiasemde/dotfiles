  "catppuccin-icons.hidesExplorerArrows": true,
  "cmake.pinnedCommands": [
    "workbench.action.tasks.configureTaskRunner",
    "workbench.action.tasks.runTask"
  ],
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.codeLens": false,
  "editor.codeLensFontFamily": "Iosevka Nerd Font Mono",
  "editor.cursorBlinking": "solid",
  "editor.cursorStyle": "block",
  "editor.detectIndentation": false,
  "editor.fontFamily": "Iosevka Nerd Font Mono",
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  "editor.gotoLocation.multipleDeclarations": "goto",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.guides.indentation": false,
  "editor.hover.enabled": "off",
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.lightbulb.enabled": "off",
  "editor.lineHeight": 1.5,
  "editor.lineNumbers": "relative",
  "editor.links": true,
  "editor.minimap.enabled": false,
  "editor.occurrencesHighlight": "off",
  "editor.overviewRulerBorder": false,
  "editor.parameterHints.enabled": false,
  "editor.renderLineHighlight": "none",
  "editor.renderWhitespace": "selection",
  "editor.rulers": [
    80,
    120
  ],
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.selectionHighlight": false,
  "editor.showFoldingControls": "never",
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": false,
  "editor.tabSize": 2,
  "editor.unicodeHighlight.includeComments": true,
  "editor.unicodeHighlight.nonBasicASCII": true,
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": true,
  "explorer.decorations.badges": false,
  "files.autoSave": "afterDelay",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "git.decorations.enabled": false,
  "git.openRepositoryInParentFolders": "never",
  "heatmap.coolColour": "#011627",
  "heatmap.heatColour": "#D16B54",
  "heatmap.heatLevels": 20,
  "javascript.suggest.paths": false,
  "remote.SSH.remotePlatform": {
    "buteo1": "linux",
    "buteo2": "linux",
    "buteo3": "linux",
    "havik5": "linux",
    "jetson-orin-01": "linux",
    "labor-lin-01": "linux",
    "lin-ha-slv4": "linux",
    "lin-ha-slv8": "linux",
    "rds-host1": "windows"
  },
  "scm.inputFontFamily": "Iosevka Nerd Font Mono",
  "security.workspace.trust.untrustedFiles": "open",
  "svelte.ask-to-enable-ts-plugin": false,
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.closeActiveEditor",
    "workbench.action.moveEditorToNextGroup",
    "workbench.action.moveEditorToPreviousGroup",
    "workbench.action.focusPreviousGroup",
    "workbench.action.focusNextGroup",
    "workbench.action.decreaseViewSize",
    "workbench.action.increaseViewSize",
    "workbench.action.toggleSidebarVisibility",
    "workbench.action.files.openFile",
    "workbench.action.files.openFolder",
    "workbench.action.files.newUntitledFile"
  ],
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.fontFamily": "Iosevka Nerd Font Mono, monospace",
  "terminal.integrated.persistentSessionScrollback": 5000,
  "terminal.integrated.profiles.linux": {
    "zsh": {
      "icon": "heart-filled",
      "path": "zsh"
    }
  },
  "terminal.integrated.rightClickBehavior": "paste",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.tabs.enabled": false,
  "typescript.suggest.paths": false,
  "update.enableWindowsBackgroundUpdates": false,
  "update.mode": "manual",
  "update.showReleaseNotes": false,
  "window.menuBarVisibility": "compact",
  "window.title": "(ツ)_/¯ ${rootName}",
  "window.zoomLevel": 1.5,
  "workbench.activityBar.location": "hidden",
  "workbench.colorCustomizations": {
    "editor.background": "#00000000",
    "editorCursor.background": "#000000",
    "editorGroup.border": "#00000000",
    "editorGroupHeader.tabsBackground": "@background@",
    "sideBar.background": "@background@",
    "tab.activeBackground": "@surface@",
    "tab.activeBorderTop": "@muted@",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveBackground": "@background@",
    "tab.inactiveForeground": "@foreground@",
    "tab.unfocusedActiveBackground": "@background@",
    "tab.unfocusedActiveBorderTop": "@background@",
    "tab.unfocusedInactiveBackground": "@background@"
  },
  "workbench.editor.revealIfOpen": true,
  "workbench.editor.showTabs": "single",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.sideBar.location": "left",
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": false,
  "workbench.tips.enabled": false,
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.indent": 12,
  "workbench.tree.renderIndentGuides": "none",
  "chat.disableAIFeatures": true
}

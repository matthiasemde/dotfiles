{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    ":rebaseStalePrs"
  ],
  "labels": [
    "dependencies"
  ],
  "automergeStrategy": "fast-forward",
  "lockFileMaintenance": {
    "enabled": true,
    "extends": [
      "schedule:weekly"
    ],
    "automerge": true,
    "timezone": "Europe/Berlin"
  },
  "nix": {
    "enabled": true
  }
}
